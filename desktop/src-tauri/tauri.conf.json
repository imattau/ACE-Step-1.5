{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACE-Step",
  "version": "0.1.0",
  "identifier": "ai.acestep.ACEStep",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data:; media-src 'self' blob:; style-src 'self' 'unsafe-inline'"
    },
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "ACE-Step",
        "width": 1280,
        "height": 860,
        "minWidth": 800,
        "minHeight": 600,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "icon": []
  }
}
